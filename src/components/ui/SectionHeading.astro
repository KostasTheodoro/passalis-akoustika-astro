---
/**
 * A section's heading block.
 *
 * The heading level is the caller's decision, not this component's: the same visual treatment is
 * an `h1` on a category page and an `h2` on the home page, and hard-coding either is how heading
 * order quietly breaks. `size` controls how it looks; `as` controls what it is.
 */
interface Props {
  title: string;
  as?: 'h1' | 'h2' | 'h3';
  size?: 'display' | 'title' | 'section';
  eyebrow?: string;
  description?: string;
  align?: 'start' | 'center';
  class?: string;
}

const {
  title,
  as: Tag = 'h2',
  size = 'section',
  eyebrow,
  description,
  align = 'center',
  class: className,
}: Props = Astro.props;

const sizes = {
  display: 'text-display',
  title: 'text-title',
  section: 'text-section',
} as const;
---

<div
  class:list={[
    'flex flex-col gap-3',
    align === 'center' ? 'items-center text-center' : 'items-start text-start',
    className,
  ]}
>
  {eyebrow && <p class="text-eyebrow">{eyebrow}</p>}

  {/* Teal headings are the site's signature. At these sizes the logo teal clears its contrast bar. */}
  <Tag class:list={['font-bold text-balance text-brand', sizes[size]]}>{title}</Tag>

  {
    description && (
      <p class:list={['text-body-lg text-ink-muted text-pretty measure', align === 'center' && 'mx-auto']}>
        {description}
      </p>
    )
  }
</div>
