---
/**
 * The one place page width and gutters are decided.
 *
 * The legacy site set a max width and horizontal padding per component, which is why the home
 * page, the catalogue and the contact page never quite lined up with each other. Every section
 * from STEP-05 onward goes through this.
 */
interface Props {
  /**
   * `narrow` is the reading measure for long-form text; `medium` is the catalogue's, where a wide
   * column leaves the cards looking empty; `wide` is for full-bleed-ish grids.
   */
  size?: 'narrow' | 'medium' | 'default' | 'wide';
  class?: string;
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
}

const { size = 'default', class: className, as: Tag = 'div' }: Props = Astro.props;

const widths = {
  narrow: 'max-w-narrow',
  medium: 'max-w-medium',
  default: 'max-w-default',
  wide: 'max-w-wide',
} as const;
---

<Tag
  class:list={[
    'mx-auto w-full px-gutter md:px-gutter-md lg:px-gutter-lg',
    widths[size],
    className,
  ]}
>
  <slot />
</Tag>
