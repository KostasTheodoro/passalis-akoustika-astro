---
import { Icon } from 'astro-icon/components';
import type { ServiceCard } from '@/data/home';
import { ICONS } from '@/data/icons';

/**
 * One of the four reasons on the home page.
 *
 * Deliberately not a `Card`: the live site draws these straight on the background with no surface
 * under them, and four white boxes here would compete with the product cards further down the
 * page for no gain. The only addition is the pale disc behind the icon, which gives four
 * differently-shaped glyphs a common silhouette so the row reads as one set.
 *
 * `as` exists because these sit in a `<ul>` on the home page but may not everywhere.
 */
interface Props extends ServiceCard {
  as?: 'div' | 'li';
}

const { icon, title, description, as: Tag = 'li' }: Props = Astro.props;
---

<Tag class="flex flex-col items-center gap-3 text-center">
  <span class="flex size-14 items-center justify-center rounded-pill bg-brand-100">
    <Icon name={ICONS[icon]} class="size-7 text-brand-strong" aria-hidden="true" />
  </span>

  {/*
    Ink, not teal. The live site sets these four titles in the body colour and reserves teal for
    section headings and product names — putting them in teal was a change the rebuild made and
    did not need. It also takes the last card title off the teal contrast ramp entirely: ink is
    9.97:1 on white and clears AA on every ground without argument.
  */}
  <h3 class="text-card font-bold text-ink text-balance">{title}</h3>

  <p class="text-body text-ink-muted text-pretty">{description}</p>
</Tag>
