---
import BrandLogo from '@/components/layout/BrandLogo.astro';
import Container from '@/components/ui/Container.astro';
import { BUSINESS } from '@/data/business';
import { FOOTER_NAV } from '@/data/navigation';

/**
 * The footer.
 *
 * The live site's footer is a single teal strip with a copyright line in English. This keeps that
 * strip — it is the one piece of the footer anyone would recognise — and puts a proper footer
 * above it: the logo and a one-line description, then the two navigation columns.
 *
 * It carried the opening hours, telephone, email and address as a third column until STEP-05.
 * The maintainer removed them on 2026-07-26: the home page's closing band renders the same four
 * values from the same `BUSINESS` object, and having them in the footer of every page as well was
 * too much of the same thing. `BusinessContactList.astro` is where they live now, and
 * `tests/e2e/shell.spec.ts` asserts the footer does not quietly grow them back.
 */
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <Container size="default" class="py-section-tight">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr]">
      <div class="flex flex-col gap-5 sm:col-span-2 lg:col-span-1">
        <BrandLogo height={48} />

        <p class="max-w-xs text-small text-ink-muted">
          Ακουστικά βαρηκοΐας, έλεγχος ακοής και υποστήριξη στο Μαρούσι.
        </p>
      </div>

      {
        FOOTER_NAV.map((group) => (
          <nav aria-label={group.heading}>
            <h2 class="text-eyebrow">{group.heading}</h2>

            <ul class="mt-4 flex flex-col gap-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="rounded-control text-small text-ink transition-colors duration-(--duration-fast) hover:text-brand-strong hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

    </div>
  </Container>

  {/*
    The teal strip the live site ends on, kept — with the copyright finally in Greek.

    The fill is `brand-strong` rather than the identity teal for the same reason the buttons are:
    the line sits at 14px, and white on the identity teal is 3.38:1 against the 4.5:1 a line of
    text that size needs. `tests/unit/tokens.test.ts` checks this pairing directly.
  */}
  <div class="on-brand bg-brand-strong text-white">
    <Container size="default" class="py-4">
      <p class="text-center text-small">
        © {year} {BUSINESS.name}. Με επιφύλαξη παντός δικαιώματος.
      </p>
    </Container>
  </div>
</footer>
