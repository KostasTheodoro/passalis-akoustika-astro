---
import { Icon } from 'astro-icon/components';
import BrandLogo from '@/components/layout/BrandLogo.astro';
import Container from '@/components/ui/Container.astro';
import { BUSINESS, fullAddress } from '@/data/business';
import { EXTERNAL_LINKS } from '@/data/external-links';
import { ICONS } from '@/data/icons';
import { FOOTER_NAV } from '@/data/navigation';

/**
 * The footer.
 *
 * The live site's footer is a single teal strip with a copyright line in English. This keeps that
 * strip — it is the one piece of the footer anyone would recognise — and puts a proper footer
 * above it: the logo, a one-line description and the shop's address and telephone in the first
 * column, then the two navigation columns.
 *
 * **That last line has been removed and put back, deliberately, and the history matters.** It was a
 * full third column of opening hours, telephone, email and address until STEP-05, when the
 * maintainer removed it: the home page's closing band renders the same four values and repeating
 * them under every page was too much of the same thing.
 *
 * STEP-09 restored the address and telephone alone, beneath the logo, for a reason the earlier
 * decision did not have in front of it. The `HearingAidStore` structured data emits the shop's name, address
 * and telephone on every route, and `specifications/seo.md` asks that structured data describe what
 * the page shows. Without this line, twelve of the fourteen routes showed neither below 1024px. For
 * local search a visible NAP is also worth more than the markup on its own.
 *
 * The icons and their treatment are the header's, not a second set: same `size-4 shrink-0
 * text-brand`, same `gap-2`, same destinations. Both are `aria-hidden`, so the text carries the
 * meaning and an icon is never the only label.
 */
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <Container size="default" class="py-section-tight">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr]">
      <div class="flex flex-col gap-5 sm:col-span-2 lg:col-span-1">
        <BrandLogo height={48} />

        <p class="max-w-xs text-small text-ink-muted">
          Ακουστικά βαρηκοΐας, έλεγχος ακοής και υποστήριξη στο Μαρούσι.
        </p>

        {/*
          The address and telephone belong under the logo rather than in a band of their own: this
          column is already the one that says who the business is, and the sentence above it names
          the locality. As a full-width row they read as a separate section for no reason.
        */}
        <div class="flex flex-col items-start gap-2.5 text-small">
          <a
            href={EXTERNAL_LINKS.googleMaps.place}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-control text-ink transition-colors duration-(--duration-fast) hover:text-brand-strong"
          >
            <Icon name={ICONS.mapPin} class="size-4 shrink-0 text-brand" aria-hidden="true" />
            <span>{fullAddress}</span>
            <span class="sr-only">— άνοιγμα στους χάρτες Google</span>
          </a>

          <a
            href={BUSINESS.telephone.href}
            class="inline-flex items-center gap-2 whitespace-nowrap rounded-control text-ink transition-colors duration-(--duration-fast) hover:text-brand-strong"
          >
            <Icon name={ICONS.phone} class="size-4 shrink-0 text-brand" aria-hidden="true" />
            {BUSINESS.telephone.display}
          </a>
        </div>
      </div>

      {
        FOOTER_NAV.map((group) => (
          <nav aria-label={group.heading}>
            <h2 class="text-eyebrow">{group.heading}</h2>

            <ul class="mt-4 flex flex-col gap-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="rounded-control text-small text-ink transition-colors duration-(--duration-fast) hover:text-brand-strong hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

    </div>
  </Container>

  {/*
    The teal strip the live site ends on, kept — with the copyright finally in Greek.

    The fill is `brand-strong` rather than the identity teal for the same reason the buttons are:
    the line sits at 14px, and white on the identity teal is 3.38:1 against the 4.5:1 a line of
    text that size needs. `tests/unit/tokens.test.ts` checks this pairing directly.
  */}
  <div class="on-brand bg-brand-strong text-white">
    <Container size="default" class="py-4">
      <p class="text-center text-small">
        © {year} {BUSINESS.name}. Με επιφύλαξη παντός δικαιώματος.
      </p>
    </Container>
  </div>
</footer>
