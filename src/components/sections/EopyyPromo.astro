---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import { HOME } from '@/data/home';
import { getEopyySubsidy } from '@/lib/content/collections';

/**
 * The teal EOPYY card — the page's one block of colour, and the only thing on it that rounds to
 * 32px. It does not use `Card`, which is white by definition.
 *
 * **The gradient.** The live card runs `#18b1b1` to `cyan-200`, and white text on that pastel end
 * measures 1.25:1 — one of the contrast defects STEP-00 logged against the live home page. This
 * keeps the gradient and loses the defect: three stops down our own teal ramp, running to the
 * bottom-left, so the identity teal survives only as a highlight in the top-right corner where the
 * card has padding and no words.
 *
 * Left to right, so the lighter teal reads as a band down the left edge rather than a corner. The
 * generous padding and the slightly smaller type are what make that band visible: the more of the
 * card the text does not cover, the more of the gradient there is to see.
 *
 * The `12%` is load-bearing, not a round number. It has to sit inside the left padding gutter,
 * before the earliest letter — then every letter sits between `brand-strong` (4.74:1 under white)
 * and `brand-deep` (6.38:1), and because *both* of those clear AA on their own the guarantee holds
 * whatever colour space the browser interpolates in. An earlier draft of this card put the stop at
 * 30% of a diagonal and the top two lines landed at 4.38:1. `tests/e2e/home.spec.ts` recomputes
 * the geometry for whatever direction and stop are set here and fails if any text reaches the
 * light segment, so this cannot be adjusted by eye into a contrast failure.
 *
 * The whole card is the link, as on the live site. There is deliberately nothing else clickable
 * inside it: an overlay anchor and a second link in the same box is a trap for anyone tabbing.
 */
const { eopyyCard } = HOME;
const subsidy = await getEopyySubsidy();

const amount = `${subsidy.adultAmount}€`;
const linkLabel = `${eopyyCard.headline} — ${amount}. Διαβάστε για τη συμμετοχή του ΕΟΠΥΥ.`;
---

<Section tone="surface" labelledby="eopyy-heading">
  <div
    class:list={[
      'on-brand relative mx-auto flex max-w-sm flex-col items-center gap-5 rounded-card-lg px-11 py-12 text-center text-white',
      'bg-linear-to-r from-brand from-0% via-brand-strong via-12% to-brand-deep',
      'shadow-lg transition-[transform,box-shadow] duration-(--duration-fast) ease-out',
      'hover:shadow-xl focus-within:shadow-xl motion-safe:hover:scale-105 motion-safe:focus-within:scale-105',
    ]}
  >
    <a href={eopyyCard.href} aria-label={linkLabel} class="absolute inset-0 rounded-card-lg"></a>

    <p id="eopyy-heading" class="text-section font-bold">
      <span class="sr-only">Επιδότηση ΕΟΠΥΥ: </span>{amount}
    </p>

    {/*
      18px bold — a notch down from the live card's 20px, so more of the gradient shows. The width
      cap wraps the note onto two lines the way the live card's explicit `<br>` does, and keeps
      both lines clear of the light band down the left edge.
    */}
    <p class="max-w-64 text-body-lg font-bold text-balance">{eopyyCard.headline}</p>

    <span class="flex size-32 shrink-0 items-center justify-center rounded-pill bg-surface">
      <Image
        src={eopyyCard.logo}
        alt={eopyyCard.logoAlt}
        layout="none"
        widths={[110, 220]}
        sizes="110px"
        loading="lazy"
        decoding="async"
        class="size-[110px] object-contain"
      />
    </span>

    <p class="max-w-64 text-body-lg font-bold text-balance">{eopyyCard.note}</p>
  </div>
</Section>
