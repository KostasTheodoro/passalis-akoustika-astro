---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import { HOME } from '@/data/home';
import { getEopyySubsidy } from '@/lib/content/collections';

/**
 * The teal EOPYY card — the page's one block of colour, and the only thing on it that rounds to
 * 32px. It does not use `Card`, which is white by definition.
 *
 * **The gradient.** The live card runs `#18b1b1` to `cyan-200`, and white text on that pastel end
 * measures 1.25:1 — one of the contrast defects STEP-00 logged against the live home page. This
 * keeps the gradient and loses the defect: three stops down our own teal ramp, running to the
 * bottom-left, so the identity teal survives only as a highlight in the top-right corner where the
 * card has padding and no words.
 *
 * The `15%` is load-bearing, not a round number. Text starts at 22.6% along this gradient's line,
 * so putting `brand-strong` at 15% means every letter sits between `brand-strong` (4.74:1 under
 * white) and `brand-deep` (6.38:1) — and because *both* of those clear AA on their own, the
 * guarantee holds whatever colour space the browser interpolates in. At the 30% it started out
 * with, the top two lines landed at 4.38:1. `tests/e2e/home.spec.ts` recomputes that geometry and
 * fails if any text ever reaches the light segment.
 *
 * The whole card is the link, as on the live site. There is deliberately nothing else clickable
 * inside it: an overlay anchor and a second link in the same box is a trap for anyone tabbing.
 */
const { eopyyCard } = HOME;
const subsidy = await getEopyySubsidy();

const amount = `${subsidy.adultAmount}€`;
const linkLabel = `${eopyyCard.headline} — ${amount}. Διαβάστε για τη συμμετοχή του ΕΟΠΥΥ.`;
---

<Section tone="surface" labelledby="eopyy-heading">
  <div
    class:list={[
      'on-brand relative mx-auto flex max-w-sm flex-col items-center gap-4 rounded-card-lg p-card-lg text-center text-white',
      'bg-linear-to-bl from-brand from-0% via-brand-strong via-15% to-brand-deep',
      'shadow-lg transition-[transform,box-shadow] duration-(--duration-fast) ease-out',
      'hover:shadow-xl focus-within:shadow-xl motion-safe:hover:scale-105 motion-safe:focus-within:scale-105',
    ]}
  >
    <a href={eopyyCard.href} aria-label={linkLabel} class="absolute inset-0 rounded-card-lg"></a>

    <p id="eopyy-heading" class="text-title font-bold">
      <span class="sr-only">Επιδότηση ΕΟΠΥΥ: </span>{amount}
    </p>

    {/* `text-card` is 18–20px; the live card sets both of these lines at 20px. All bold. */}
    <p class="text-card font-bold text-balance">{eopyyCard.headline}</p>

    <span class="flex size-32 shrink-0 items-center justify-center rounded-pill bg-surface">
      <Image
        src={eopyyCard.logo}
        alt={eopyyCard.logoAlt}
        layout="none"
        widths={[110, 220]}
        sizes="110px"
        loading="lazy"
        decoding="async"
        class="size-[110px] object-contain"
      />
    </span>

    <p class="text-card font-bold text-balance">{eopyyCard.note}</p>
  </div>
</Section>
