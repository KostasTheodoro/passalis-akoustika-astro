---
import ContactBand from '@/components/sections/ContactBand.astro';
import { CATALOGUE } from '@/data/catalogue';

/**
 * The contact band on `/akoustika` and all four category pages.
 *
 * All this does now is name which strings the catalogue uses. The band itself is `ContactBand`,
 * which the five informational routes share, so a change to the treatment lands on all ten routes
 * at once instead of on five.
 *
 * The heading id is passed explicitly to keep these five pages exactly as they shipped.
 */
const { contact } = CATALOGUE;
---

<ContactBand
  heading={contact.heading}
  description={contact.description}
  cta={contact.cta}
  headingId="catalogue-cta-heading"
/>
