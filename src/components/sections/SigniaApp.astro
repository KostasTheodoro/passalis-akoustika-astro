---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { EXTERNAL_LINKS } from '@/data/external-links';
import { HOME } from '@/data/home';

/**
 * `Κατεβάστε το Signia App`, and the last thing on the page — where the maintainer wants it.
 *
 * Two columns from `md` up: the copy on the left, the logo and the two store badges on the right.
 * The live site stacks everything on the left and leaves half the desktop width empty.
 *
 * The badges are the official artwork, shipped as supplied. Their alt text is the link's
 * accessible name, so it says what the link does rather than describing the picture, and each one
 * carries a screen-reader-only note that it opens a new tab.
 *
 * **Why the two badges are given different heights.** Google's badge is drawn on a 646×250 canvas
 * with 41px of transparent clear space on every side — the clear space is part of the artwork and
 * Google's brand guidelines require it, so it is not cropped out. Apple's SVG has none: the badge
 * fills its 119.66×40 box. Give both elements the same height and Google's *visible* badge lands
 * 33% smaller, which is exactly what the rebuild shipped. Each is therefore sized by its own
 * content fraction, so the two visible badges match. `tests/e2e/home.spec.ts` measures the opaque
 * bounding box of each asset and fails if they drift apart.
 */
const { signiaApp } = HOME;

/** The height both badges should *appear*, before each one's own clear space is added back. */
const BADGE_HEIGHT = '3rem';

const stores = [
  {
    ...signiaApp.badges.appStore,
    href: EXTERNAL_LINKS.signiaApp.appStore,
    /** The SVG has no clear space, so the element height is the badge height. */
    contentFraction: 1,
  },
  {
    ...signiaApp.badges.googlePlay,
    href: EXTERNAL_LINKS.signiaApp.googlePlay,
    /** 168 visible pixels on a 250px canvas. */
    contentFraction: 168 / 250,
  },
];
---

{/* `page` rather than `surface`: the footer is white, and two white blocks in a row would read as
    one. The section grounds across the page alternate deliberately. */}
<Section tone="page" labelledby="signia-heading">
  <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
    <div class="flex flex-col gap-4">
      <SectionHeading id="signia-heading" title={signiaApp.heading} align="start" />

      {signiaApp.body.map((paragraph) => <p class="text-body-lg text-ink-muted text-pretty measure">{paragraph}</p>)}

      <p class="text-small text-ink-muted italic">{signiaApp.note}</p>
    </div>

    <div class="flex flex-col items-center gap-8">
      <Image
        src={signiaApp.logo}
        alt={signiaApp.logoAlt}
        layout="none"
        widths={[180, 360]}
        sizes="180px"
        loading="lazy"
        decoding="async"
        class="h-auto w-45"
      />

      <ul class="flex list-none flex-wrap items-center justify-center gap-4">
        {
          stores.map((store) => (
            <li>
              <a
                href={store.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'inline-flex rounded-control',
                  'transition-transform duration-(--duration-fast) ease-out',
                  'motion-safe:hover:scale-105 motion-safe:focus-visible:scale-105 motion-safe:active:scale-95',
                ]}
              >
                <Image
                  src={store.image}
                  alt={store.alt}
                  layout="none"
                  widths={[160, 320]}
                  sizes="160px"
                  loading="lazy"
                  decoding="async"
                  class="w-auto"
                  style={`height: calc(${BADGE_HEIGHT} / ${store.contentFraction})`}
                />
                <span class="sr-only"> — ανοίγει σε νέα καρτέλα</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
