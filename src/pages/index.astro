---
import EopyyPromo from '@/components/sections/EopyyPromo.astro';
import HomeHero from '@/components/sections/HomeHero.astro';
import HomeServices from '@/components/sections/HomeServices.astro';
import { HOME } from '@/data/home';
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * The home page.
 *
 * This file owns one thing: which sections there are and in what order. Every section holds its
 * own markup and reads its own copy from `src/data/home.ts` or a content collection, so changing
 * the order here changes the page and nothing else.
 *
 * The order is the live site's, deliberately — hero, why us, EOPYY, the aids, then the app. The
 * closing contact band is the one addition.
 */
---

<BaseLayout title={HOME.seo.title} description={HOME.seo.description}>
  <HomeHero />
  <HomeServices />
  <EopyyPromo />
</BaseLayout>
