---
import ContactCta from '@/components/sections/ContactCta.astro';
import EopyyPromo from '@/components/sections/EopyyPromo.astro';
import FeaturedModels from '@/components/sections/FeaturedModels.astro';
import HomeHero from '@/components/sections/HomeHero.astro';
import HomeServices from '@/components/sections/HomeServices.astro';
import SigniaApp from '@/components/sections/SigniaApp.astro';
import { HOME } from '@/data/home';
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * The home page.
 *
 * This file owns one thing: which sections there are and in what order. Each section holds its own
 * markup and reads its own copy from `src/data/home.ts` or a content collection, so changing the
 * order here changes the page and nothing else.
 *
 * The order is the live site's, deliberately — hero, why us, EOPYY, the aids, then the app. The
 * closing contact band is the one addition, and it goes above the app section because the app
 * section stays at the bottom.
 */
---

{/*
  The one route that opts out of the title template. Its title *is* the site default and already
  names the brand, so appending the suffix would say it twice — exactly what the live site does on
  /synergates. `buildTitle` throws rather than allowing it, which is why this flag is explicit.
*/}
<BaseLayout title={HOME.seo.title} description={HOME.seo.description} brandInTitle={false}>
  <HomeHero />
  <HomeServices />
  <EopyyPromo />
  <FeaturedModels />
  <ContactCta />
  <SigniaApp />
</BaseLayout>
