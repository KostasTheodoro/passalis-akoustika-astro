---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/*
      The ear mark from the logo, on the white ground the live site already uses. The wordmark is
      unreadable at 16px, so it is not the icon. STEP-09 adds the web manifest that will reference
      /icon-192.png and /icon-512.png.
    */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Only the two upright faces are preloaded; the italics load on demand. */}
    <Font
      cssVariable="--font-sansation"
      preload={[
        { weight: 400, style: 'normal' },
        { weight: 700, style: 'normal' },
      ]}
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
