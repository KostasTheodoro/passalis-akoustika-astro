---
import { Font } from 'astro:assets';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import Breadcrumbs, { type BreadcrumbItem } from '@/components/navigation/Breadcrumbs.astro';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import Container from '@/components/ui/Container.astro';
import '../styles/global.css';

/**
 * The shell every page renders inside.
 *
 * This layout owns the site's only `<main>`. No page may render one of its own — the live site
 * has nested `<main>` elements on seven routes because each page reached for the landmark
 * separately, and that is the defect this arrangement exists to prevent.
 *
 * `description` is accepted now so pages have somewhere to put it; STEP-09 owns the rest of the
 * document head, including titles, canonicals, social metadata and structured data.
 */
interface Props {
  title: string;
  description?: string;
  /** Rendered above the page heading on nested routes. Home is added by the component. */
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, breadcrumbs }: Props = Astro.props;
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/*
      The ear mark from the logo, on the white ground the live site already uses. The wordmark is
      unreadable at 16px, so it is not the icon. STEP-09 adds the web manifest that will reference
      /icon-192.png and /icon-512.png.
    */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Only the two upright faces are preloaded; the italics load on demand. */}
    <Font
      cssVariable="--font-sansation"
      preload={[
        { weight: 400, style: 'normal' },
        { weight: 700, style: 'normal' },
      ]}
    />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <SkipLink />
    <SiteHeader />

    {/* `tabindex="-1"` is what lets the skip link actually move focus here, not just the viewport. */}
    <main id="main" tabindex="-1" class="flex-1">
      {
        breadcrumbs && (
          <Container size="default" class="pt-6">
            <Breadcrumbs items={breadcrumbs} />
          </Container>
        )
      }
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
