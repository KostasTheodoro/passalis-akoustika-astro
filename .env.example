# Copy this file to `.env` and fill in the values for local development.
# `.env` is git-ignored and must never be committed.

# Public base URL of the site. Used for canonical URLs and absolute links.
# Exposed to the browser, so it must not contain anything secret.
PUBLIC_SITE_URL=http://localhost:4321

# Additional variables (transactional email credentials for the contact form)
# are introduced later, alongside the feature that needs them.
