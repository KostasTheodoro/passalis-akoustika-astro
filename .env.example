# Copy this file to `.env` and fill in the values for local development.
# `.env` is git-ignored and must never be committed.

# Public base URL of the site. Used for canonical URLs and absolute links.
# Exposed to the browser, so it must not contain anything secret.
PUBLIC_SITE_URL=http://localhost:4321

# --- Contact form -------------------------------------------------------------------------------
#
# All four are server-only secrets and never reach the browser. The two addresses are not secrets
# the way an API key is, but they are exactly what an address harvester wants and nothing on the
# client needs them, so they are declared `access: 'secret'` rather than trusted to stay server-side.
#
# LEAVE RESEND_API_KEY EMPTY LOCALLY. Without it the endpoint still validates, rate-limits and
# builds both emails exactly as it would in production, then stops short of sending and returns an
# explicit development result that the form states on screen. Nothing reports success for a message
# that was not sent.
#
# That is also what makes the test suite safe by construction rather than by discipline: with no key
# present, no code path can reach Resend. Set it only when deliberately testing real delivery.

# From the Resend dashboard. Starts with `re_`.
RESEND_API_KEY=

# Where enquiries are delivered. One address.
CONTACT_RECIPIENT_EMAIL=owner@example.com

# The verified sender. Must sit on a domain verified in Resend, which is STEP-11's work, so mail
# will not actually send before then. The visitor's own address is never used as the sender: the
# legacy site did that, and a forged From is rejected or spam-foldered by SPF and DKIM checks.
CONTACT_SENDER_EMAIL=noreply@example.com

# Display name shown beside the sender address.
CONTACT_SENDER_NAME=Πασσαλής Ακουστικά
